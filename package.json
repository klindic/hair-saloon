{
  "name": "hair-saloon",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build && node tools/pages-postbuild.mjs",
    "build:pages": "ng build --base-href /hair-saloon/ && node tools/pages-postbuild.mjs",
    "preview": "npm run build:pages && node tools/serve-static.mjs --base /hair-saloon/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p apps-script/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "ng test",
    "test:script": "vitest run --config apps-script/vitest.config.mts",
    "test:e2e": "playwright test",
    "check:contract": "node tools/check-contract.mjs",
    "check:contrast": "node tools/check-contrast.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run check:contract && npm run check:contrast && npm run test && npm run test:script && npm run script:build && npm run build && npm run check:pages && npm run check:no-secrets && npm run check:fonts",
    "verify:all": "npm run verify && npm run test:e2e",
    "script:build": "node apps-script/build.mjs",
    "script:push": "clasp push",
    "check:pages": "npm run build:pages && node tools/check-pages-build.mjs",
    "check:no-secrets": "node tools/check-no-secrets.mjs",
    "check:fonts": "npm run build:pages && node tools/check-fonts-build.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/work-sans": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.4",
    "@google/clasp": "3.4.1",
    "@playwright/test": "1.64.1",
    "@types/google-apps-script": "2.0.15",
    "@types/node": "24.19.2",
    "angular-eslint": "22.6.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
