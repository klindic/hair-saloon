{
  "compilerOptions": {
    "strict": true,
    "target": "ES2019",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2019"],
    "types": ["google-apps-script"],
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@contract/*": ["../shared/*"]
    }
  },
  "include": ["**/*.ts"]
}
