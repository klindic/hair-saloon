{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "hair-saloon": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              {
                "glob": "{fraunces-latin-standard-normal.woff2,fraunces-latin-ext-standard-normal.woff2}",
                "input": "node_modules/@fontsource-variable/fraunces/files",
                "output": "fonts/fraunces"
              },
              {
                "glob": "{work-sans-latin-400-normal.woff2,work-sans-latin-ext-400-normal.woff2,work-sans-latin-500-normal.woff2,work-sans-latin-ext-500-normal.woff2,work-sans-latin-600-normal.woff2,work-sans-latin-ext-600-normal.woff2}",
                "input": "node_modules/@fontsource/work-sans/files",
                "output": "fonts/work-sans"
              }
            ],
            "styles": ["src/styles.scss"],
            "externalDependencies": ["fonts/*"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "hair-saloon:build:production"
            },
            "development": {
              "buildTarget": "hair-saloon:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
